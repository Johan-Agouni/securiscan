# ─────────────────────────────────────────────────────────────────────────────
# SecuriScan Client – Production Environment Variables
# Copy to client/.env.local before running 'next build'.
#
# NEXT_PUBLIC_* values are baked into the JS bundle at build time.
# ─────────────────────────────────────────────────────────────────────────────

# The domain of your VPS (Nginx proxies /api/* to port 4000)
NEXT_PUBLIC_API_URL=https://yourdomain.com

NEXT_PUBLIC_APP_NAME=SecuriScan

# Stripe publishable key (safe to expose – it's public by design)
# Get from https://dashboard.stripe.com/apikeys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...

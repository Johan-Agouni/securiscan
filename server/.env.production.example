# ─────────────────────────────────────────────────────────────────────────────
# SecuriScan Server – Production Environment Variables
# Copy to server/.env and fill in every value before deploying.
#
# Generate secrets with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# ─────────────────────────────────────────────────────────────────────────────

# ── App ───────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=4000

# Public URL of the frontend (used for CORS + email links)
# Must match the domain in your Nginx config
FRONTEND_URL=https://yourdomain.com

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
# Get these from /root/.securiscan-db-info after running setup-vps.sh
DATABASE_URL=postgresql://securiscan:<PASSWORD>@localhost:5432/securiscan_prod

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://127.0.0.1:6379

# ── JWT Secrets (generate with the command above) ─────────────────────────────
JWT_SECRET=<64-byte-hex-secret>
JWT_REFRESH_SECRET=<64-byte-hex-secret-different-from-above>
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ── Stripe ────────────────────────────────────────────────────────────────────
# Live keys from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_...
# Webhook secret from https://dashboard.stripe.com/webhooks
# Endpoint URL: https://yourdomain.com/api/payments/webhook
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Email (Resend) ────────────────────────────────────────────────────────────
# Get API key from https://resend.com/api-keys
RESEND_API_KEY=re_...
FROM_EMAIL=noreply@yourdomain.com
